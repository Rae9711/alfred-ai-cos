{
  "expo": {
    "name": "Alfred",
    "slug": "albert",
    "scheme": "albert",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/45e050ed-fd8c-494a-8173-821548b192f5",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.haoruiwang.alfred",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["shortcuts"],
        "NSContactsUsageDescription": "Alfred looks up contacts when you ask to text someone by name.",
        "NSPhotoLibraryUsageDescription": "Alfred reads a recent chat screenshot to draft a reply, then deletes that screenshot."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.haoruiwang.alfred"
        ],
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)com.haoruiwang.alfred",
          "$(AppIdentifierPrefix)com.haoruiwang.alfred.shared"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F9F4E8"
      },
      "package": "com.haoruiwang.alfred",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "intentFilters": [
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [{ "mimeType": "text/plain" }]
        },
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": {
            "scheme": "albert",
            "host": "share"
          }
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-audio",
      "expo-web-browser",
      "expo-font",
      "expo-updates",
      [
        "expo-contacts",
        {
          "contactsPermission": "Alfred looks up contacts when you ask to text someone by name."
        }
      ],
      "./plugins/withAlfredKeyboard.js"
    ],
    "extra": {
      "apiBaseUrl": "https://alfredaitech.com",
      "sentryDsn": "",
      "router": {},
      "eas": {
        "projectId": "45e050ed-fd8c-494a-8173-821548b192f5"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "slurpdurp"
  }
}
